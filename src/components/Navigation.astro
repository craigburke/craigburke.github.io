---
/**
 * Navigation Component
 * 
 * Main site navigation with responsive behavior and theme toggle. The site name
 * anchors the left side, while page navigation and the theme toggle align right.
 * 
 * Navigation items are configured in src/config.ts. Active page highlighting is
 * handled both server-side and client-side for View Transitions support.
 * 
 * @component
 * 
 * @example
 * ```astro
 * <Navigation />
 * ```
 */
import { siteConfig } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

/**
 * Navigation items configured for the site.
 */
const navItems = siteConfig.nav;

/**
 * Determines if a navigation item should be marked as active
 * 
 * Home link is only active on the exact root path. Other links are active
 * if the current path starts with their href, allowing child pages to
 * highlight their parent navigation item.
 * 
 * @param href - The navigation item's URL
 * @returns True if the navigation item should be marked as active
 */
const isActive = (href: string) => {
  return currentPath.startsWith(href);
};
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-content">
    <a class="site-name" href="/">Craig Burke</a>
    <div class="nav-scroll">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li class="nav-item">
            <a 
              href={item.href} 
              class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="nav-end">
      <ThemeToggle />
    </div>
  </div>
</nav>

<script>
  function updateActiveNav() {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('.nav-link');
    
    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      let isActive = false;
      
      if (href) {
        isActive = currentPath.startsWith(href);
      }
      
      link.classList.toggle('nav-link--active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  // Run on initial load and after each navigation
  document.addEventListener('astro:page-load', updateActiveNav);
</script>

<style>
  .site-nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: var(--space-md) 0;
    margin-bottom: var(--space-md);
  }

  .nav-content {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    margin: 0 auto;
    max-width: 1100px;
    padding: 0 1.5rem;
    width: 100%;
  }

  .site-name {
    color: var(--color-text);
    flex-shrink: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-scroll {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .nav-scroll::-webkit-scrollbar {
    display: none;
  }

  .nav-list {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-end;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.5rem 0.5rem 0;
    min-width: max-content;
  }

  .nav-item {
    margin: 0;
    flex-shrink: 0;
  }

  .nav-link {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link--active {
    color: var(--color-text);
  }

  .nav-end {
    align-items: center;
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-shrink: 0;
    margin-left: .75rem;
    padding-left: .75rem;
  }

  @media (max-width: 768px) {
    .nav-content { padding: 0 1rem; }
    .site-name { font-size: 1rem; }

    .nav-list {
      justify-content: flex-start;
      gap: 1.5rem;
      padding: 0.5rem 1rem;
    }

    .nav-link {
      font-size: 0.75rem;
    }

    .nav-end {
      margin-left: .5rem;
      padding-left: .5rem;
    }

  }
</style>
