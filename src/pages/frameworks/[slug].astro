---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import BackLink from '../../components/BackLink.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const frameworks = await getCollection('frameworks');
  return frameworks.map((framework) => ({ params: { slug: framework.id } }));
}

const framework = await getEntry('frameworks', Astro.params.slug!);
if (!framework) return Astro.redirect('/404');
const { Content } = await render(framework);
---

<BaseLayout>
  <SEO slot="head" title={framework.data.title} description={framework.data.summary} type="article" />
  <article class="framework-page">
    <header>
      <p>Salesforce Framework</p>
      <h1>{framework.data.title}</h1>
      <p>{framework.data.summary}</p>
    </header>
    <div class="content"><Content /></div>
    <BackLink href="/frameworks" text="All frameworks" />
  </article>
  <style>
    .framework-page { max-width: 1100px; margin: 0 auto; padding: 3.5rem 1.5rem 5rem; }
    header { border-bottom: 1px solid var(--color-border); margin-bottom: 3rem; padding-bottom: 2rem; }
    header > p:first-child { color: var(--color-accent); font-size: .72rem; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
    h1 { font-size: clamp(2.5rem, 6vw, 4.4rem); letter-spacing: -.025em; line-height: 1.05; margin: .6rem 0 1.25rem; }
    header > p:last-child, .content :global(p), .content :global(li) { color: var(--color-text-secondary); font-size: 1.03rem; line-height: 1.7; }
    .content :global(h2) { font-size: 1.65rem; letter-spacing: -.02em; margin: 3rem 0 1rem; }
    .content :global(h2:first-child) { margin-top: 0; }
    .content :global(ul) { padding-left: 1.25rem; }
    .content :global(li) { margin-bottom: .55rem; }
    .content :global(pre) { overflow-x: auto; }
  </style>
</BaseLayout>
