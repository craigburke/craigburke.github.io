---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FrameworkCard from '../components/FrameworkCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

const projects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const frameworks = (await getCollection('frameworks'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <SEO slot="head" title={siteConfig.title} description={siteConfig.description} type="website" noSuffix />

  <div class="home-page">
    <section class="hero" aria-labelledby="intro-heading">
      <div class="hero-left">
        <p class="eyebrow">{siteConfig.author.title}</p>
        <h1 id="intro-heading">Craig Burke</h1>

        <p class="hero-copy">Salesforce Technical Architect and Principal Developer with 8+ years of Salesforce experience and 20+ years of enterprise application development experience.</p>
        <p>{siteConfig.author.location}</p>

        <div class="actions">
          <a class="button button-primary" href="#selected-work">View projects</a>
          <a class="button button-primary" href="/frameworks">View Frameworks</a>
        </div>

      </div>
      <div class="hero-right" aria-label="Professional profile">
        <div class="eyebrow">9x Salesforce certified</div>
        <ul class="certification-badges">
          <li><img src="/images/certifications/application-architect.png" alt="Salesforce Certified Application Architect" title="Application Architect" /></li>
          <li><img src="/images/certifications/platform-data-architect.png" alt="Salesforce Certified Platform Data Architect" title="Platform Data Architect" /></li>
          <li><img src="/images/certifications/platform-sharing-visibility-architect.png" alt="Salesforce Certified Platform Sharing and Visibility Architect" title="Platform Sharing and Visibility Architect" /></li>
          <li><img src="/images/certifications/platform-developer-ii.png" alt="Salesforce Certified Platform Developer II" title="Platform Developer II" /></li>
          <li><img src="/images/certifications/platform-developer-i.png" alt="Salesforce Certified Platform Developer I" title="Platform Developer I" /></li>
          <li><img src="/images/certifications/javascript-developer.png" alt="Salesforce Certified JavaScript Developer" title="JavaScript Developer" /></li>
          <li><img src="/images/certifications/platform-app-builder.png" alt="Salesforce Certified Platform App Builder" title="Platform App Builder" /></li>
          <li><img src="/images/certifications/advanced-administrator.png" alt="Salesforce Certified Advanced Administrator" title="Advanced Administrator" /></li>
          <li><img src="/images/certifications/administrator.png" alt="Salesforce Certified Administrator" title="Administrator" /></li>
        </ul>
      </div>
    </section>

    <section id="selected-work" class="section" aria-labelledby="selected-work-heading">
      <div class="section-heading">
        <h2 id="selected-work-heading">Integration Projects</h2>
        <p>Architected and built end-to-end finance, gift, payroll, and student data integrations with data modeling, asynchronous processing, and supporting Lightning web applications.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard title={project.data.title} slug={project.id} outcomeSummary={project.data.outcomeSummary} techStack={project.data.techStack} featured={project.data.featured} />)}
      </div>
    </section>

    <section class="section foundation-section" aria-labelledby="foundations-heading">
      <div class="section-heading">
        <h2 id="foundations-heading">Salesforce Frameworks</h2>
        <p>This section includes Salesforce frameworks I developed for asynchronous job orchestration, trigger handling, and test data builders. Technical readers can examine a representative Apex example for each framework.</p>
      </div>
      <div class=framework-grid>
        {frameworks.map((framework) => <FrameworkCard title={framework.data.title} slug={framework.id} summary={framework.data.summary} />)}
      </div>
    </section>

    <section class="section results" aria-labelledby="results-heading">
      <h2 id="results-heading">Platform Reliability, Performance, and Security</h2>
      <p class="results-intro">Improved bulk performance, strengthened sharing and field-level security, and increased test reliability.</p>
      <dl>
        <div><dt>82%</dt><dd>faster bulk updates for 300K+ Accounts</dd></div>
        <div><dt>60%</dt><dd>faster bulk updates for 300K+ Contacts</dd></div>
        <div><dt>483</dt><dd>Apex classes and triggers upgraded to API version 67</dd></div>
        <div><dt>186</dt><dd>Apex test failures eliminated</dd></div>
      </dl>
    </section>

    <section class="closing-cta" aria-label="Contact">
      <p>I’m seeking a fully remote Salesforce Technical Architect or Lead Developer role. Contact me at <a href="mailto:craig@craigburke.com">craig@craigburke.com</a>.</p>
    </section>
  </div>

  <style>
    .home-page { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 5rem; }
    .hero { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; padding: 5rem 0; border-bottom: 1px solid var(--color-border); }
    .eyebrow { color: var(--color-accent); font-size: .72rem; font-weight: 650; letter-spacing: .1em; margin: 0 0 .9rem; text-transform: uppercase; }
    h1 { font-size: clamp(2.6rem, 6vw, 4.8rem); line-height: 1.04; letter-spacing: -.025em; margin: 0 0 1.5rem; }
    h2 { font-size: clamp(1.9rem, 4vw, 3.2rem); letter-spacing: -.02em; line-height: 1.1; margin: 0; }
    h3 { font-size: 1.1rem; margin-top: 0; }
    .hero-copy, .section-heading > p { color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.7; }
    .hero-copy { max-width: 60ch; }
    .profile { align-self: end; border-left: 1px solid var(--color-accent); color: var(--color-text-secondary); padding-left: 1.25rem; }
    .profile p + p { border-top: 1px solid var(--color-border); margin-top: 1.25rem; padding-top: 1.25rem; }
    .hero-right { align-self: center; border-left: 1px solid var(--color-accent); padding-left: 1.25rem; }
    .certification-badges { display: grid; gap: .65rem; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
    .certification-badges img { display: block; height: auto; max-width: 6rem; width: 100%; }
    .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
    .button { border: 1px solid var(--color-border); border-radius: 6px; color: var(--color-text); font-weight: 600; padding: .75rem 1rem; text-decoration: none; }
    .button-primary { background: var(--color-text); color: var(--color-bg); }
    .section { padding: 5rem 0; }
    .section-heading { margin-bottom: 2.5rem; }
    .section-heading > p { margin: 1.25rem 0 0; }
    .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .foundation-section { border-top: 1px solid var(--color-border); }
    .framework-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .framework-grid article { border-top: 1px solid var(--color-accent); padding-top: 1rem; }
    .framework-grid p { color: var(--color-text-secondary); line-height: 1.65; }
    .framework-grid strong { color: var(--color-accent); font-size: .85rem; }
    .results { border-top: 1px solid var(--color-border); }
    .results h2 { margin-bottom: 2.25rem; }
    .results-intro { color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.7; margin: -1rem 0 2.25rem; }
    .closing-cta { border-top: 1px solid var(--color-border); padding: 3rem 0 0; }
    .closing-cta p { color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.7; margin: 0; max-width: 60ch; }
    .closing-cta a { text-underline-offset: .2em; }
    .detail-list { display: grid; gap: .65rem; }
    .detail-list div { display: grid; gap: .35rem; grid-template-columns: minmax(10rem, .3fr) 1fr; }
    dl { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 0; }
    dl div { border-top: 1px solid var(--color-border); padding-top: 1rem; }
    dt { font-size: clamp(2.25rem, 5vw, 4rem); font-weight: 650; letter-spacing: -.06em; line-height: 1; }
    dd { color: var(--color-text-secondary); font-size: .9rem; line-height: 1.5; margin: .75rem 0 0; }
    @media (max-width: 760px) { .hero, .section-heading { grid-template-columns: 1fr; gap: 2rem; } .hero-right { max-width: 28rem; } .project-grid, .framework-grid, dl { grid-template-columns: 1fr; } .section { padding: 3.75rem 0; } }
  </style>
</BaseLayout>
