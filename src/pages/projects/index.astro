---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<BaseLayout>
  <SEO slot="head" title="Integration Projects" description="Salesforce integration projects by Craig Burke." type="website" />
  <main class="page-container">
    <header class="page-header">
      <h1>Integration projects</h1>
      <p>Architected and built end-to-end finance, gift, payroll, and student data integrations with data modeling, asynchronous processing, and supporting Lightning web applications.</p>
    </header>
    <div class="card-list">
      {projects.map((project) => <ProjectCard title={project.data.title} slug={project.id} outcomeSummary={project.data.outcomeSummary} techStack={project.data.techStack} featured={project.data.featured} />)}
    </div>
  </main>
  <style>
    .page-container { max-width: 1100px; margin: 0 auto; padding: 3.5rem 1.5rem 5rem; }
    .page-header { border-bottom: 1px solid var(--color-border); margin-bottom: 2.5rem; padding-bottom: 2.5rem; max-width: 760px; }
    h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: -.025em; line-height: 1.05; margin: .5rem 0 1rem; }
    .page-header > p:last-child { color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.7; }
    .card-list { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media (max-width: 700px) { .card-list { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
