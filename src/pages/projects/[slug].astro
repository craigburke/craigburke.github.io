---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import BackLink from '../../components/BackLink.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id } }));
}

const project = await getEntry('projects', Astro.params.slug!);
if (!project) return Astro.redirect('/404');
const { title, outcomeSummary, mainScreenshot, problem, approach, techStack, impact } = project.data;
---

<BaseLayout>
  <SEO slot="head" title={`${title} — Integration Project`} description={outcomeSummary} type="article" />
  <article class="case-study">
    <header class="case-header">
      <p class="eyebrow">Integration Project</p>
      <h1>{title}</h1>
      <p class="tech-stack"><strong>Built with:</strong> {techStack.join(' · ')}</p>
      <p class="outcome">{outcomeSummary}</p>
      {mainScreenshot && (
        <figure class="main-screenshot">
          <img src={mainScreenshot.src} alt={mainScreenshot.alt} />
          <figcaption>{mainScreenshot.caption}</figcaption>
        </figure>
      )}
    </header>

    <section><h2>The problem</h2><p>{problem}</p></section>
    <section><h2>Implementation</h2><p>{approach}</p></section>
    <section><h2>Results</h2>{impact.metrics.length > 0 && <dl>{impact.metrics.map((metric) => <div><dt>{metric.value}</dt><dd>{metric.label}</dd></div>)}</dl>}<p>{impact.qualitative}</p></section>
    <BackLink href="/projects" text="All integration projects" />
  </article>

  <style>
    .case-study { max-width: 1100px; margin: 0 auto; padding: 3.5rem 1.5rem 5rem; }
    .case-header { border-bottom: 1px solid var(--color-border); margin-bottom: 3.5rem; padding-bottom: 2.25rem; }
    .eyebrow { color: var(--color-accent); font-size: .72rem; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
    h1 { font-size: clamp(2.4rem, 6vw, 4.4rem); letter-spacing: -.025em; line-height: 1.05; margin: .6rem 0 1.25rem; }
    h2 { font-size: 1.65rem; letter-spacing: -.02em; margin: 0 0 1rem; }
    section { margin-bottom: 3rem; }
    p { color: var(--color-text-secondary); font-size: 1.03rem; line-height: 1.7; }
    .outcome { color: var(--color-text-secondary); font-size: 1.2rem; line-height: 1.65; }
    .main-screenshot { margin-top: 2rem; }
    .main-screenshot img { border: 1px solid var(--color-border); border-radius: .5rem; display: block; width: 100%; }
    .main-screenshot figcaption { color: var(--color-text-muted); font-size: .9rem; margin-top: .65rem; }
    .tech-stack { color: var(--color-text-muted); font-size: .9rem; margin-top: 1.25rem; }
    .tech-stack strong { color: var(--color-text-secondary); }
    dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin: 0 0 1.5rem; }
    dl div { border-top: 1px solid var(--color-border); padding-top: .75rem; }
    dt { color: var(--color-text); font-size: 1.8rem; font-weight: 650; letter-spacing: -.04em; }
    dd { color: var(--color-text-secondary); font-size: .85rem; line-height: 1.45; margin: .4rem 0 0; }
  </style>
</BaseLayout>
